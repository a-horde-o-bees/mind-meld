{
  "name": "@mind-meld/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:generate": "node scripts/generate-schema.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mind-meld-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply mind-meld-dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply mind-meld-prod --remote --env production",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.4.21",
    "kysely": "^0.29.5",
    "y-partyserver": "^2.2.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
