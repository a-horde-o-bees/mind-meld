node_modules/
dist/
.wrangler/
data/
*.log
.DS_Store
coverage/

# Local secrets for `wrangler dev`. Use .env.example as the template. A stray
# .dev.vars would silently take precedence over .env, so it is ignored too.
.env*
!.env.example
.dev.vars*

# Android signing key produced by Bubblewrap. Losing it means the Play listing
# can never be updated, so back it up outside the repo.
packaging/android-twa/*.keystore
packaging/android-twa/android/

# Playwright MCP snapshots written during browser-driven verification.
.playwright-mcp/
